{
  "name": "@salescareerhub/db",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "dotenv -e ../../.env -- prisma generate",
    "push": "dotenv -e ../../.env -- prisma db push",
    "seed": "dotenv -e ../../.env -- tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "studio": "dotenv -e ../../.env -- prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "@salescareerhub/config": "workspace:*"
  },
  "devDependencies": {
    "prisma": "^5.19.0",
    "tsx": "^4.16.0",
    "dotenv-cli": "^7.4.0",
    "typescript": "^5.5.0",
    "@types/node": "^20.14.0"
  }
}
